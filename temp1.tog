ls -l /dev/video* 2>/dev/null || true
ls -l /dev/ttyS* /dev/ttyUSB* /dev/ttyACM* 2>/dev/null || true

lsmod
lsmod | grep -iE 'rknpu|rockchip|npu' || true

dmesg | grep -iE 'rknpu|npu|rk3588|rockchip' || true
journalctl -k -b 2>/dev/null | grep -iE 'rknpu|npu|rk3588|rockchip' || true
```

